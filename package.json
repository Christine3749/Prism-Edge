{
  "name": "prism-edge",
  "private": true,
  "version": "0.1.2",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/electron"
  ],
  "scripts": {
    "dev": "tsx server.ts",
    "dev:web": "tsx server.ts",
    "dev:api": "python -m uvicorn services.api.app.main:app --host 0.0.0.0 --port 8000 --reload",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node -e \"process.env.NODE_ENV='production'; require('./dist/server.cjs')\"",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "lint": "tsc --noEmit",
    "api:check": "python -m compileall services",
    "electron": "npm --workspace prism-edge-electron run start",
    "electron:pack": "npm --workspace prism-edge-electron run pack",
    "electron:dist": "npm --workspace prism-edge-electron run dist",
    "release:r2": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/publish-electron-r2.ps1",
    "release:r2:skip-build": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/publish-electron-r2.ps1 -SkipBuild"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "ws": "^8.18.0",
    "lightweight-charts": "^5.2.0",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/ws": "^8.5.13",
    "@types/node": "^22.14.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  }
}
