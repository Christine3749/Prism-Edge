PORT=3000
API_BASE_URL="http://127.0.0.1:8000"
APP_URL="http://localhost:3000"
VITE_ENABLE_LIVE_BINANCE=false
# Browser-side gateway override for static/Vercel deployments.
# Keep empty when /api is served by the same Node gateway. Use https://api.msirprism.com after DNS is mapped.
VITE_API_BASE_URL=""
VITE_WS_BASE_URL=""

# Server-side market provider router keys. Leave empty to skip the provider automatically.
# Route order: Binance/Coinbase -> Polygon/TwelveData/Finnhub -> Alpha Vantage -> Yahoo -> simulated.
POLYGON_API_KEY=""
# MASSIVE_API_KEY is also accepted as a Polygon-compatible key name.
MASSIVE_API_KEY=""
TWELVE_DATA_API_KEY=""
FINNHUB_API_KEY=""
ALPHA_VANTAGE_API_KEY=""

# Shared secret for Node → FastAPI internal calls.
# Leave empty in development (auth is disabled when unset).
# In production, set to a random 32+ char string and pass to both services.
INTERNAL_API_KEY=""

# Max analysis requests per minute per IP (default: 20)
ANALYSIS_RATE_LIMIT=20

# Path to the DGWM quant project root (only needed for DGWM runtime diagnostic).
# Leave empty when the local quant project is not mounted.
DGWM_ROOT=""
# HalfSphere / HS membership binding for Prism Edge.
# Existing account API on Aliyun 210; identity and passwords are checked locally there.
# Frontend continues sending its HS Bearer token to the same Node APIs.
HS_ACCOUNT_URL="https://account.gsyen.com"
HS_PRODUCT_CODE="msir_prism"
# off = local/dev compatible, warn = allow with headers, enforce = block unauthorized access. Production should use enforce.
HS_MEMBERSHIP_ENFORCEMENT="off"
